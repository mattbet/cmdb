# plugins/vcloud_utils.py (o dags/vcloud_utils.py)
from airflow.models import Variable
import requests

# Preleva l'URL in modo sicuro dalle variabili di Airflow
VCLOUD_URL = Variable.get("NORD_url")
VCLOUD_TENANT = Variable.get("ARPA_Lazio_Tenant")

def vcloud_login_refresh(**kwargs):
    """
    Recupera l'API Token generato da console memorizzato nelle Variabili di Airflow.
    Inietta il token in XCom per renderlo disponibile a tutte le altre interrogazioni.
    """
    print("⚙️ [vCloud Utils] Recupero dell'API Token di console da Airflow Variables...")
    
    # Preleva il token in modo sicuro dalle variabili di Airflow
    CONSOLE_TOKEN = Variable.get("DADC4A14445_token")
    
    if not CONSOLE_TOKEN:
        raise Exception("Errore: La variabile 'DADC4A14445_token' non è configurata su Airflow.")
    
    # NOTA TECNICA: Se il tuo token di console richiede uno scambio di sessione (OAuth/Refresh),
    # scommenta le righe sotto per fare il refresh, altrimenti lascialo passare direttamente.
    
    # Esempio se il token va scambiato con una sessione temporanea:
    login_url = f"{VCLOUD_URL}/oauth/tenant/{VCLOUD_TENANT}/token?grant_type=refresh_token&refresh_token={CONSOLE_TOKEN}"
    headers = {
        "Accept": "application/*+json"
#        "Accept": "application/*+json;version=38.0",
#        "X-VMWARE-VCLOUD-ACCESS-TOKEN": CONSOLE_TOKEN # o l'header richiesto da vCloud
    }
    response = requests.post(login_url, headers=headers)
    token_valido = response.headers.get("X-VMWARE-VCLOUD-ACCESS-TOKEN")
    return token_valido
    

    print("🔑 [vCloud Utils] Token di console caricato correttamente e passato alle XCom.")
    return CONSOLE_TOKEN

